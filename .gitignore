# ==========================================
# Slack — Repository Root .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
*.env
!.env.example
!.env.sample
slack-api/.env
slack-web/.env.local
slack-web/.env*.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!slack-web/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Linting artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruff_cache/
.mypy_cache/

# Node.js / Next.js artifacts
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# Vercel & Netlify
.vercel
.netlify

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System & IDE
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Antigravity / Agent runtime artifacts
.gemini/
.agents/
